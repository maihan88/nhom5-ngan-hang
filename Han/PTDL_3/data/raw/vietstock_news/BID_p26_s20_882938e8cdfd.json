[{"StockCode": "BID", "ChannelID": 1104, "Head": "Năm 2024, tín dụng tăng tốc giúp lợi nhuận ngân hàng vươn lên đỉnh mới. Đây cũng là động lực chính được kỳ vọng sẽ tiếp tục giúp lợi nhuận ngân hàng giữ đà tăng trưởng trong năm 2025.", "ArticleID": 1271736, "Title": "Lợi nhuận ngân hàng 2024 tiếp tục vượt đỉnh, trông chờ gì ở năm 2025?", "PublishTime": "/Date(1739512920000)/", "Content": "", "URL": "/2025/02/loi-nhuan-ngan-hang-2024-tiep-tuc-vuot-dinh-trong-cho-gi-o-nam-2025-737-1271736.htm", "TotalRow": 2945, "Source": "FILI", "Icon": null}, {"StockCode": "BID", "ChannelID": 1104, "Head": "", "ArticleID": 1271632, "Title": "BID: HĐQT thông qua hợp đồng bảo hiểm tiền, vàng vận chuyển của CN với BIC", "PublishTime": "/Date(1739443740000)/", "Content": "", "URL": "/2025/02/bid-hdqt-thong-qua-hop-dong-bao-hiem-tien-vang-van-chuyen-cua-cn-voi-bic-830-1271632.htm", "TotalRow": 2945, "Source": "HOSE", "Icon": null}, {"StockCode": "BID", "ChannelID": 1104, "Head": "Việc giảm lãi suất tiền gửi đầu tháng 2/2025 chủ yếu xuất phát từ thanh khoản dồi dào sau Tết, nhu cầu tín dụng giảm, chính sách tiền tệ nới lỏng và chiến lược tối ưu hóa chi phí vốn của ngân hàng.", "ArticleID": 1270873, "Title": "Lãi suất tiền gửi giảm nhẹ sau Tết Nguyên đán", "PublishTime": "/Date(1739426520000)/", "Content": "", "URL": "/2025/02/lai-suat-tien-gui-giam-nhe-sau-tet-nguyen-dan-757-1270873.htm", "TotalRow": 2945, "Source": "FILI", "Icon": null}, {"StockCode": "BID", "ChannelID": 1104, "Head": "", "ArticleID": 1271291, "Title": "BID123004: Công bố thông tin Văn bản của Ủy ban Chứng khoán Nhà nước về hồ sơ đăng ký chào bán cổ phiếu riêng lẻ của BID", "PublishTime": "/Date(1739354940000)/", "Content": "", "URL": "/2025/02/bid123004-cong-bo-thong-tin-van-ban-cua-uy-ban-chung-khoan-nha-nuoc-ve-ho-so-dang-ky-chao-ban-co-phieu-rieng-le-cua-bid-739-1271291.htm", "TotalRow": 2945, "Source": "HNX", "Icon": null}, {"StockCode": "BID", "ChannelID": 1104, "Head": "", "ArticleID": 1271289, "Title": "BID123003