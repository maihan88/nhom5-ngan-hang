[{"StockCode": "BID", "ChannelID": 1104, "Head": "Tăng trưởng tín dụng chậm lại đã tác động tiêu cực đến hoạt động kinh doanh của hầu hết các ngân hàng trong quý đầu năm 2023.", "ArticleID": 1071290, "Title": "Lợi nhuận ngân hàng giảm tốc", "PublishTime": "/Date(1684216800000)/", "Content": "", "URL": "/2023/05/loi-nhuan-ngan-hang-giam-toc-737-1071290.htm", "TotalRow": 2945, "Source": "FILI", "Icon": null}, {"StockCode": "BID", "ChannelID": 1104, "Head": "Hai chỉ số thị trường đều ghi nhận mức tăng tích cực trong tuần 08-12/05/2023. Cụ thể, VN-Index chinh phục thành công mốc 1,060 điểm, kết thúc tuần với mức điểm 1,066.9 (tăng 2.56% so với cuối tuần giao dịch trước). Còn với HNX-Index, chỉ số kết thúc tuần ở 215.1 điểm, tăng 3.51%.", "ArticleID": 1070836, "Title": "Cổ phiếu nào giúp VN-Index vượt mốc 1,060 điểm trong tuần qua?", "PublishTime": "/Date(1683981000000)/", "Content": "", "URL": "/2023/05/co-phieu-nao-giup-vn-index-vuot-moc-1060-diem-trong-tuan-qua-830-1070836.htm", "TotalRow": 2945, "Source": "FILI", "Icon": null}, {"StockCode": "BID", "ChannelID": 1104, "Head": "Sau hơn 1 tháng rao bán nợ của chủ đầu tư dự án nhà máy thủy điện Tân Thượng, Ngân hàng TMCP Đầu tư và Phát triển Việt Nam (BIDV, HOSE: BID) tiếp tục rao bán khoản nợ hơn 1,016 tỷ đồng của 2 doanh nghiệp liên quan đến nhà máy thủy điện Đắk Psi.", "ArticleID": 1070605, "Title": "BIDV rao bán nợ của chủ đầu tư 2 dự án nhà máy thủy điện", "PublishTime": "/Date(1683883252427)/", "Content": "", "URL": "/2023/05/bidv-rao-ban-no-cua-chu-dau-tu-2-du-an-nha-may-thuy-dien-757-1070605.htm", "TotalRow": 2945, "Source": "FILI", "Icon": null}, {"StockCode": "BID", "ChannelID": 1104, "Head": "", "ArticleID": 1070284, "Title": "BID: Thông báo điều lệ BIDV 2023", "PublishTime": "/Date(1683794580000)/", "Content": "", "URL": "/2023/05/bid-thong-bao-dieu-le-bidv-2023-737-1070284.htm", "TotalRow": 2945, "Source": "HOSE", "Icon": null}, {"StockCode": "BID", "ChannelID": 1104, "Head": "", "ArticleID": 1072644, "Title": "BID: Công bố thông tin Điều lệ BIDV 2023", "PublishTime": "/Date(1683717960000)/", "Content": "", "URL": "/2023/05/bid-cong-bo-thong-tin-dieu-le-bidv-2023-737-1072644.htm", "TotalRow": 2945, "Source": "HNX", "Icon": null}, {"StockCode": "BID", "ChannelID": 1104, "Head": "", "ArticleID": 1070114, "Title": "BID: CBTT Điều lệ BIDV 2023", "PublishTime": "/Date(1683717960000)/", "Content": "", "URL": "/2023/05/bid-cbtt-dieu-le-bidv-2023-737-1070114.htm", "TotalRow": 2945, "Source": "HNX", "Icon": null}, {"StockCode": "BID", "ChannelID": 1104, "Head": "Sau ĐHĐCĐ năm 2023, một số ngân hàng đã thông qua kế hoạch chuyển sàn sang niêm yết lên HOSE cũng như đổi tên viết tắt.", "ArticleID": 1068820, "Title": "Ngân hàng bàn chuyện đổi tên, chuyển sàn", "PublishTime": "/Date(1683615188557)/", "Content": "", "URL": "/2023/05/ngan-hang-ban-chuyen-doi-ten-chuyen-san-757-1068820.htm", "TotalRow": 2945, "Source": "FILI", "Icon": null}, {"StockCode": "BID", "ChannelID": 1104, "Head": "Đầu tháng 5, mặt bằng lãi suất tiền gửi tiết kiệm tiếp tục giảm trong bối cảnh Chính phủ và Ngân hàng Nhà nước kéo hạ mặt bằng lãi suất để hỗ trợ nền kinh tế.", "ArticleID": 1068803, "Title": "Đầu tháng 5, lãi suất tiền gửi tiếp tục hạ nhiệt ", "PublishTime": "/Date(1683612000000)/", "Content": "", "URL": "/2023/05/dau-thang-5-lai-suat-tien-gui-tiep-tuc-ha-nhiet-757-1068803.htm", "TotalRow": 2945, "Source": "FILI", "Icon": null}, {"StockCode": "BID", "ChannelID": 1104, "Head": "Thị trường chứng khoán Việt Nam chịu áp lực điều chỉnh khiến diễn biến cổ phiếu ngân hàng cũng kém sắc theo.", "ArticleID": 1069119, "Title": "Cổ phiếu ngân hàng kém sắc trong tháng 4", "PublishTime": "/Date(1683550800000)/", "Content": "", "URL": "/2023/05/co-phieu-ngan-hang-kem-sac-trong-thang-4-830-1069119.htm", "TotalRow": 2945, "Source": "FILI", "Icon": null}, {"StockCode": "BID", "ChannelID": 1104, "Head": "", "ArticleID": 1072606, "Title": "BID: Công bố thông tin về giao dịch với bên có liên quan", "PublishTime": "/Date(