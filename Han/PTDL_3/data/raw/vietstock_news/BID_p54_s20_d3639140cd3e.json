[{"StockCode": "BID", "ChannelID": 1104, "Head": "Dữ liệu Sở Giao dịch Chứng khoán Hà Nội (HNX) công bố trong tháng 10 ghi nhận 23 đợt phát hành trái phiếu riêng lẻ của 14 doanh nghiệp. Tổng giá trị huy động đạt 26,326 tỷ đồng, giảm gần 3,000 tỷ đồng so với tháng 9, tương ứng giảm hơn 10%.", "ArticleID": 1120830, "Title": "Các “ông lớn” nào phát hành hơn 26,000 tỷ đồng trái phiếu riêng lẻ trong tháng 10?", "PublishTime": "/Date(1699322400000)/", "Content": "", "URL": "/2023/11/cac-ong-lon-nao-phat-hanh-hon-26000-ty-dong-trai-phieu-rieng-le-trong-thang-10-3118-1120830.htm", "TotalRow": 2945, "Source": "FILI", "Icon": null}, {"StockCode": "BID", "ChannelID": 1104, "Head": "Sau nhiều tuần giảm mạnh, hai chỉ số thị trường trong tuần 30/10-03/11/2023 có diễn biến trái ngược nhau. Cụ thể, VN-Index trở lại đà tăng với mức 1.52% so với cuối tuần trước, kết thúc tuần tại 1,076.78 điểm. Còn với HNX-Index, chỉ số giảm nhẹ 0.13%, xuống mức 217.75 điểm.", "ArticleID": 1120547, "Title": "Cổ phiếu nào giúp VN-Index lấy lại được sắc xanh?", "PublishTime": "/Date(1699190963350)/", "Content": "", "URL": "/2023/11/co-phieu-nao-giup-vn-index-lay-lai-duoc-sac-xanh-830-1120547.htm", "TotalRow": 2945, "Source": "FILI", "Icon": null}, {"StockCode": "BID", "ChannelID": 1104, "Head": "", "ArticleID": 1120499, "Title": "BID: Thông báo về giao dịch với bên có liên quan", "PublishTime": "/Date(1699009200000)/", "Content": "", "URL": "/2023/11/bid-thong-bao-ve-giao-dich-voi-ben-co-lien-quan-739-1120499.htm", "TotalRow": 2945, "Source": "HOSE", "Icon": null}, {"StockCode": "BID", "ChannelID": 1104, "Head": "", "ArticleID": 1138887, "Title": "CBTT về việc đăng ký giao dịch trái phiếu BIDL2224008 của Ngân hàng TMCP Đầu tư và Phát triển Việt Nam", "PublishTime": "/Date(1698944400000)/", "Content": "", "URL": "/2023/11/cbtt-ve-viec-dang-ky-giao-dich-trai-phieu-bidl2224008-cua-ngan-hang-tmcp-dau-tu-va-phat-trien-viet-nam-3118-1138887.htm", "TotalRow": 2945, "Source": "HNX", "Icon": null}, {"StockCode"