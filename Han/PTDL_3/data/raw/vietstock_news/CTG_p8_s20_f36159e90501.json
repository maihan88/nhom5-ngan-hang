[{"StockCode": "CTG", "ChannelID": 639, "Head": "Khép lại năm 2025 với lợi nhuận phá vỡ đỉnh cũ, ngành ngân hàng dường như chỉ mới phô diễn phần nổi của tảng băng thịnh vượng. Bên dưới tảng băng này, áp lực trích lập dự phòng đang trở thành “vùng đệm” bắt buộc khi nguy cơ nợ xấu vẫn lặng lẽ hiện diện phía sau các con số tăng trưởng.", "ArticleID": 1401753, "Title": "Bên dưới ‘tảng băng’ lợi nhuận ngân hàng năm 2025", "PublishTime": "/Date(1770612958080)/", "Content": "", "URL": "/2026/02/ben-duoi-8216tang-bang8217-loi-nhuan-ngan-hang-nam-2025-737-1401753.htm", "TotalRow": 3004, "Source": "FILI", "Icon": null}, {"StockCode": "CTG", "ChannelID": 639, "Head": "Thị trường chứng khoán khởi động năm mới với gam màu tích cực. Trong bức tranh đó, cổ phiếu ngân hàng một lần nữa khẳng định vị thế “vua” khi tỏa sáng rực rỡ, mang “lộc” đầu năm cho nhà đầu tư.", "ArticleID": 1400181, "Title": "Cổ phiếu vua hái lộc đầu năm", "PublishTime": "/Date(1770296520000)/", "Content": "", "URL": "/2026/02/co-phieu-vua-hai-loc-dau-nam-830-1400181.htm", "TotalRow": 3004, "Source": "FILI", "Icon": null}, {"StockCode": "CTG", "ChannelID": 639, "Head": "", "ArticleID": 1398428, "Title": "CTG: Báo cáo tình hình quản trị công ty năm 2025", "PublishTime": "/Date(1769997450000)/", "Content": "", "URL": "/2026/02/ctg-bao-cao-tinh-hinh-quan-tri-cong-ty-nam-2025-737-1398428.htm", "TotalRow": 3004, "Source": "HOSE", "Icon": null}, {"StockCode": "CTG", "ChannelID": 639, "Head": "Theo BCTC hợp nhất vừa công bố, Ngân hàng TMCP Công Thương Việt Nam (VietinBank, HOSE: CTG) lãi trước thuế năm 2025 gần 43,446 tỷ đồng, tăng 37% so với năm trước nhờ giảm mạnh dự phòng rủi ro tín dụng. Đáng chú ý, cho vay khách hàng tại thời điểm cuối năm đạt hơn 1.99 triệu tỷ đồng.", "ArticleID": 1398253, "Title": "VietinBank tăng 37% lãi trước thuế năm 2025, tín dụng tiến sát mốc 2 triệu tỷ đồng", "PublishTime": "/Date(1769835483910)/", "Content": "", "URL": "/2026/01/vietinbank-tang-37-lai-truoc-thue-nam-2025-tin-dung-tien-sa